APP_NAME="POS Rumah Makan Padang"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=padang_pos
DB_USERNAME=padang_pos_user
DB_PASSWORD=

# Akun seed hanya untuk development. Set POS_SEED_USERS=false di produksi
# dan buat akun lewat: php artisan user:create <username> <role>
# Password seed harus diisi minimal 12 karakter bila seeder diaktifkan.
POS_SEED_USERS=false
POS_OWNER_USERNAME=owner
POS_OWNER_NAME="Pemilik Rumah Makan"
POS_OWNER_EMAIL=owner@example.test
POS_OWNER_PASSWORD=
POS_ADMIN_USERNAME=admin
POS_ADMIN_NAME=Administrator
POS_ADMIN_EMAIL=admin@example.test
POS_ADMIN_PASSWORD=
POS_CASHIER_USERNAME=kasir01
POS_CASHIER_NAME="Kasir 01"
POS_CASHIER_EMAIL=kasir01@example.test
POS_CASHIER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan berikut hanya bila aplikasi produksi sudah melayani HTTPS.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
